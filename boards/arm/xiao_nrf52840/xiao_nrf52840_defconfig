CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_XIAO_NRF52840=y

# Enable MPU and stack protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# XIAO has external 32kHz crystal
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# Use on-chip BLE controller with SoftDevice Link Layer
CONFIG_BT_CTLR=y
CONFIG_BT_LL_SOFTDEVICE=y

# Enable PWM for RC outputs
CONFIG_PWM=y
